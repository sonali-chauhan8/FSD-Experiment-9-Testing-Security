# ====================================================================
# Backend Environment Configuration Template (Experiment 9)
# Copy this file to .env and customize as needed
# ====================================================================
PORT=5000

# MongoDB Connection String (Local instance or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/student_mgmt_exp9_dev
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student_mgmt_exp9_dev?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/student_mgmt_exp9_dev

# Allowed Frontend URL for CORS Security
CLIENT_URL=http://localhost:5173

# Application Environment: development | production | test
NODE_ENV=development
