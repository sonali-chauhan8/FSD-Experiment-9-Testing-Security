{
  "info": {
    "_postman_id": "c1f7a8b9-45e2-411a-9cf8-927b2c0e8a71",
    "name": "Experiment 9 - Student Management System API Test Suite",
    "description": "Comprehensive Postman test suite for Experiment 9: Full Stack Testing, Profiling, and Security Hardening. Contains positive and negative test cases for all CRUD endpoints, input validation, and security headers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. System Health & Security",
      "item": [
        {
          "name": "GET /api/health - Verify Health & Security Configuration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Server reports healthy status\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"healthy\");",
                  "    pm.expect(json.security.helmet).to.eql(\"enabled\");",
                  "});",
                  "pm.test(\"Security headers are present\", function () {",
                  "    pm.response.to.have.header(\"x-content-type-options\");",
                  "    pm.response.to.have.header(\"x-frame-options\");",
                  "    pm.expect(pm.response.headers.get(\"x-content-type-options\")).to.eql(\"nosniff\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Create Student (POST /api/students)",
      "item": [
        {
          "name": "POST /api/students - [VALID] Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has success true and student ID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data._id).to.be.a('string');",
                  "    pm.collectionVariables.set(\"studentId\", json.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vikramaditya Rao\",\n  \"enrollmentNumber\": \"0101CS221888\",\n  \"email\": \"vikram.rao@college.edu\",\n  \"branch\": \"Computer Science & Engineering\",\n  \"semester\": 5,\n  \"mobileNumber\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
